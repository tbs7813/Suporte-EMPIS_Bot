# ESTE ARQUIVO E SO UM MODELO. Nao coloque valores reais aqui e nao publique valores reais.
# Em producao, cada item abaixo e cadastrado na Cloudflare com:
#   npx wrangler secret put NOME_DO_ITEM
# Para testar no seu computador, copie este arquivo para ".dev.vars" e preencha.

# Qual WhatsApp o bot usa: "meta" (API oficial, padrao) ou "evolution" (nao oficial, temporario).
# Para trocar de provedor basta mudar este segredo e reimplantar.
WA_PROVIDER=meta

# ---- Somente se WA_PROVIDER=evolution ----
# Endereco da Evolution API (onde o container dela esta rodando), ex.: https://evo.suaescola.com.br
EVOLUTION_URL=
# Chave global da Evolution (AUTHENTICATION_API_KEY dela)
EVOLUTION_APIKEY=
# Nome da instancia criada na Evolution (o chip da escola)
EVOLUTION_INSTANCE=
# Segredo que VOCE inventa (longo e aleatorio). Configure o MESMO valor no webhook da Evolution
# como header "x-webhook-secret". Sem ele o bot recusa todas as mensagens.
EVOLUTION_WEBHOOK_SECRET=

# ---- Somente se WA_PROVIDER=meta ----
# Token de acesso da Meta (use o token PERMANENTE do usuario do sistema)
WHATSAPP_TOKEN=
# ID do numero de telefone (Phone Number ID) em Meta > WhatsApp > Configuracao da API
PHONE_NUMBER_ID=
# Segredo do aplicativo (App Secret) em Meta > Configuracoes do app > Basico
APP_SECRET=
# Texto que VOCE inventa (ex.: uma frase longa e aleatoria). Mesmo texto na Meta e aqui.
VERIFY_TOKEN=
# Endereco do projeto Supabase, ex.: https://abcdefgh.supabase.co
SUPABASE_URL=
# Chave SECRETA (service_role / secret key) do Supabase. NUNCA publique.
SUPABASE_SERVICE_KEY=
