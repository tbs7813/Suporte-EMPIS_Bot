# MODELO. Copie para "evolution/.env" e preencha. Nunca publique valores reais.

# Endereco publico da Evolution (na Railway/VPS) ou http://localhost:8080 para teste local
SERVER_URL=http://localhost:8080

# Chave global da API: frase longa e aleatoria. Sera o EVOLUTION_APIKEY do Worker.
AUTHENTICATION_API_KEY=

# Postgres do Supabase (Session pooler, porta 5432) com schema proprio.
# Antes, no SQL Editor do Supabase:  create schema if not exists evolution_api;
DATABASE_CONNECTION_URI=postgresql://postgres.SEUREF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?schema=evolution_api

# Para onde a Evolution envia as mensagens. SEGREDO = EVOLUTION_WEBHOOK_SECRET do Worker
# (so letras e numeros, para nao precisar escapar na URL).
WEBHOOK_GLOBAL_URL=https://SEU-WORKER.workers.dev/webhook?secret=SEGREDO
